{
  "installCommand": "npm install && npm install --prefix server && npm install --prefix client",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/health.js": {
      "maxDuration": 10
    },
    "api/[...path].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**,server/dist/**}"
    }
  }
}
