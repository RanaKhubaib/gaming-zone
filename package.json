{
  "name": "gaming-zone-software",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c teal,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "cross-env NODE_ENV=production npm run start --prefix server",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jose": "^6.2.8",
    "multer": "^2.0.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@vercel/node": "^5.9.7",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "prisma": "^5.22.0",
    "tsx": "^4.23.11",
    "typescript": "^5.8.0"
  }
}
